    [jpl_horizons.py], [228], [живой парсер NASA JPL Horizons, фит $v_inf$, снимок данных],
    [scale_check.py], [191], [сравнение сфер действия с полной задачей трёх тел],
    [anim.py], [264], [анимация миссии для видеоотчёта],
